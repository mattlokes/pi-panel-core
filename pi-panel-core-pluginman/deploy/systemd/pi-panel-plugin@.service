[Unit]
Description=pi-panel plugin %i
Documentation=file:/home/pi/pi-panel-core/pi-panel-core-pluginman/README.md
PartOf=pi-panel.target
# Plugins talk to pi-panel-ctl, not the compositor, and are expected to
# reconnect if ctl restarts; so After=, not BindsTo=.
After=pi-panel-ctl.service network-online.target
Wants=network-online.target
# Started by pi-panel-ctl, never by a WantedBy= of its own (no [Install]).

[Service]
Type=exec
User=pi
Group=pi
Slice=pi-panel.slice
SyslogIdentifier=pi-panel-plugin-%i
Environment=PYTHONUNBUFFERED=1

ExecStart=/home/pi/pi-panel-core/pi-panel-core-pluginman/.venv/bin/pi-panel-run plugin %i

Restart=on-failure
RestartSec=5
TimeoutStopSec=10
