#!/bin/sh
# Launch the pi-panel kiosk compositor on bare DRM/KMS (no display manager).
# Started from ~/.bash_profile on tty1.

# Pis without a GPU MMU need the software renderer; labwc-pi does the same check.
if raspi-config nonint is_pi && ! raspi-config nonint gpu_has_mmu 2>/dev/null; then
    export WLR_RENDERER=pixman
fi

# Send stdout/stderr to the journal rather than letting it scroll over tty1,
# where it is unreadable once views map and lost entirely after a failure.
# journald storage is persistent here, so a failed boot can be read back later:
#
#   journalctl -t pi-panel -b        this boot
#   journalctl -t pi-panel -f        follow live
#   journalctl -t pi-panel -p err    errors only
#
# --level-prefix lets journald parse the <N> syslog levels the compositor
# emits when it sees JOURNAL_STREAM, so priorities are recorded properly.
# systemd-cat execs the compositor, so it keeps this PID and receives signals
# directly.
exec systemd-cat --identifier=pi-panel --level-prefix=true \
    "$HOME/pi-panel-compositor/build/pi-panel-compositor" \
    --config "$HOME/.config/pi-panel/compositor.conf" \
    "$@"
