# pi-panel kiosk views
#
#   <name>  <auto-restart: yes|no>  <command>
#
# Prefix commands with "exec" where you can: it keeps the launched process as
# the compositor's direct child. (Not required — the compositor also matches a
# client to its slot by walking up the process tree — but it is tidier.)
#
# These two placeholder views each open a shell, which is handy for confirming
# the kiosk boots and for poking around from the physical machine. Replace them
# with your real panels.

main     yes   exec foot --app-id=main --font=monospace:size=20
second   yes   exec foot --app-id=second --font=monospace:size=20

# Immich photo frame (see ~/pi-panel-immich).
#   SDL_VIDEODRIVER=wayland  - SDL would otherwise try kmsdrm and fight the
#                              compositor for the DRM device.
#   SDL_APP_ID=immich        - sets the Wayland app_id, so `switch-app immich`
#                              and `list` show something meaningful. SDL 2.26+
#                              reads SDL_APP_ID; the older SDL_VIDEO_WAYLAND_*
#                              names are ignored here.
#   uv run --script          - the script declares its own deps inline (PEP 723);
#                              uv resolves them into a cached environment.
# uv execs python as a child, so the client PID differs from the one launched -
# the compositor matches it by walking up the process tree.
immich   yes   exec env SDL_VIDEODRIVER=wayland SDL_APP_ID=immich /home/pi/.local/bin/uv run --script /home/pi/pi-panel-immich/pi_panel_immich.py --config /home/pi/pi-panel-immich/config.yaml
